<Ui xmlns="http://www.blizzard.com/wow/ui/" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.blizzard.com/wow/ui/ ..\FrameXML\UI.xsd">
  <Frame name="WoWForeverRFTBrowser" parent="UIParent" hidden="true" enableMouse="true" movable="true" clampedToScreen="true">
    <Size x="520" y="440"/>
    <Anchors>
      <Anchor point="CENTER"/>
    </Anchors>
    <Backdrop bgFile="Interface\DialogFrame\UI-DialogBox-Background" edgeFile="Interface\DialogFrame\UI-DialogBox-Border" tile="true">
      <EdgeSize val="32"/>
      <TileSize val="32"/>
      <BackgroundInsets left="11" right="12" top="12" bottom="11"/>
    </Backdrop>
    <Layers>
      <Layer level="ARTWORK">
        <FontString name="$parentTitle" parentKey="Title" inherits="GameFontNormalLarge" text="WoW-Forever Recipes">
          <Anchors>
            <Anchor point="TOP" x="0" y="-18"/>
          </Anchors>
        </FontString>
        <FontString name="$parentProfLabel" parentKey="ProfLabel" inherits="GameFontNormal" text="Profession">
          <Anchors>
            <Anchor point="TOPLEFT" x="20" y="-48"/>
          </Anchors>
        </FontString>
        <FontString name="$parentDetailTitle" parentKey="DetailTitle" inherits="GameFontHighlight">
          <Anchors>
            <Anchor point="TOPLEFT" relativePoint="TOPRIGHT" x="-230" y="-48"/>
          </Anchors>
        </FontString>
      </Layer>
    </Layers>
    <Frames>
      <Button name="$parentClose" parentKey="Close" inherits="UIPanelCloseButton">
        <Anchors>
          <Anchor point="TOPRIGHT" x="-5" y="-5"/>
        </Anchors>
      </Button>
      <Button name="$parentProfMenu" parentKey="ProfMenu" inherits="UIDropDownMenuTemplate">
        <Anchors>
          <Anchor point="TOPLEFT" x="10" y="-70"/>
        </Anchors>
      </Button>
      <ScrollFrame name="$parentRecipeScroll" parentKey="RecipeScroll" inherits="UIPanelScrollFrameTemplate">
        <Size x="250" y="310"/>
        <Anchors>
          <Anchor point="TOPLEFT" x="16" y="-100"/>
        </Anchors>
        <ScrollChild>
          <Frame name="$parentRecipeList" parentKey="RecipeList">
            <Size x="230" y="1"/>
          </Frame>
        </ScrollChild>
      </ScrollFrame>
      <ScrollFrame name="$parentDetailScroll" parentKey="DetailScroll" inherits="UIPanelScrollFrameTemplate">
        <Size x="230" y="310"/>
        <Anchors>
          <Anchor point="TOPRIGHT" x="-16" y="-100"/>
        </Anchors>
        <ScrollChild>
          <Frame name="$parentDetailList" parentKey="DetailList">
            <Size x="210" y="1"/>
          </Frame>
        </ScrollChild>
      </ScrollFrame>
      <FontString name="$parentCatalogNote" parentKey="CatalogNote" inherits="GameFontDisableSmall" justifyH="LEFT">
        <Size x="480" y="32"/>
        <Anchors>
          <Anchor point="BOTTOMLEFT" x="18" y="12"/>
        </Anchors>
      </FontString>
    </Frames>
  </Frame>
</Ui>